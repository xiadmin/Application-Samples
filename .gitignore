# Build output
/build/

# Per-sample build output written by samples_cli.py, for samples/<api>/<sample>
# and samples/<api>/<group>/<sample>. Spelled out rather than /samples/**/build/
# because git before 1.8.2 does not understand ** in ignore patterns.
/samples/*/*/build/
/samples/*/*/*/build/

# Dependencies: what builds download, and the copies a user provides
# themselves (dependencies/README.md says what goes where). Only the empty
# local/cmake, local/nuget and local/wheels folders are kept, by a .gitkeep.
/dependencies/cache/
/dependencies/local/*
!/dependencies/local/cmake/
!/dependencies/local/nuget/
!/dependencies/local/wheels/
/dependencies/local/*/*
!/dependencies/local/*/.gitkeep

# Former dependency folder, kept ignored so a leftover copy stays out of git status
.deps/

# Temporary CMake build directories
.cmake-tmp/

# Temporary .NET build directories
.dotnet-tmp/

# .NET build output and restore artifacts, created even when --output is given
bin/
obj/

# Python bytecode
__pycache__/
*.py[cod]

# Local Python tools
/.venv/
/.pytest_cache/
