<Project>
  <!-- MSBuild finds this file by walking up from each C# sample. -->
  <Import Project="$(MSBuildThisFileDirectory)dependencies/Dependencies.props" />

  <!-- A sample can be built two ways: plain dotnet build (output in bin/ and
       obj/) and samples_cli.py (output in build/). Each leaves generated .cs
       files behind, so keep all three folders out of the compile globs, or a
       build after the other one compiles AssemblyInfo.cs twice. This file is
       imported before the SDK adds its own excludes, which it appends. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);build/**;bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
