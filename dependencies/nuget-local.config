<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet settings while AUTOMATICALLY_DOWNLOAD_DEPENDENCIES is not set;
  dependencies/Dependencies.props points RestoreConfigFile here and restricts
  restore to dependencies/local/nuget. Packages the user provides are used as
  they are, without a signature check. They are extracted into their own
  folder, so a package that was not checked is never reused by a build that
  downloads and checks its packages (nuget.config).
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="cache/nuget-packages-local" />
    <add key="signatureValidationMode" value="accept" />
  </config>

  <packageSources>
    <!-- No remote source: nothing is downloaded. -->
    <clear />
  </packageSources>
</configuration>
