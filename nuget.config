<?xml version="1.0" encoding="utf-8"?>
<!--
  Package storage and sources for every C# sample. Relative paths resolve
  against this file, so all samples share one store under .deps/, the same way
  C/C++ dependencies share .deps/downloads/.
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".deps/nuget-packages" />
    <!-- Accept only packages signed by a signer listed below. Every package on
         nuget.org carries its repository signature, so this also holds for a
         .nupkg downloaded from there by hand for ApplicationSamplesDependencies=system. -->
    <add key="signatureValidationMode" value="require" />
  </config>

  <packageSources>
    <!-- Clear machine-wide sources so a build depends only on what is listed here. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- nuget.org's repository-signing certificates, as published in its service
       index. Refresh with: dotnet nuget trust source nuget.org -->
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>
</configuration>
