<?xml version="1.0" encoding="utf-8"?>
<!--
  Package storage and sources for every C# sample. Relative paths resolve
  against this file, so all samples share one store under .deps/, the same way
  C/C++ dependencies share .deps/downloads/.
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".deps/nuget-packages" />
  </config>

  <packageSources>
    <!-- Clear machine-wide sources so a build depends only on what is listed here. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
