<RecordingSetup>
<recordingStorages>
    <!-- A storage is where MultiRecorder writes the raw camera data during the
         acquisition. When performance is critical, use folders on the fastest
         drives; several folders on different drives increase the write speed. -->
    <storage name="s1">
        <folder>data</folder> <!-- relative to the working directory; usually a full path -->
    </storage>
</recordingStorages>
<tasks>
    <!-- Open the first camera connected to this computer, record 10 frames to
         storage s1, and export them as RGB TIFF files to the folder "output". -->
    <cameraTask frameCount="10" recordingStorageName="s1" exportImageFormat="XI_RGB24" exportFolder="output">
        <!-- Set the exposure to 200 ms -->
        <setCameraParam name="XI_PRM_EXPOSURE" value="200000"/>
        <!-- Set the white balance. Both "XI_PRM_WB_KR" and "wb_kr" are accepted. -->
        <setCameraParam name="XI_PRM_WB_KR" value="1.5"/>
        <setCameraParam name="XI_PRM_WB_KG" value="1.0"/>
        <setCameraParam name="XI_PRM_WB_KB" value="2.0"/>
        <!-- Set downsampling. Enum names such as "XI_DWN_1x1" are accepted as well as their values ("1"). -->
        <setCameraParam name="XI_PRM_DOWNSAMPLING" value="XI_DWN_1x1"/>
    </cameraTask>
</tasks>
</RecordingSetup>
