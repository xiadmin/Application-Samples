<RecordingSetup>
<recordingStorages>
    <!-- See record-10-images/setup.xml for a description of storages. -->
    <storage name="s2">
        <folder>data</folder>
    </storage>
</recordingStorages>
<tasks>
    <!-- Open the first camera connected to this computer, record 10 frames to
         storage s2, and export them as RGB TIFF files to the folder "output". -->
    <cameraTask frameCount="10" recordingStorageName="s2" exportImageFormat="XI_RGB24" exportFolder="output">
        <!-- Apply camera settings saved to a file (*.xicamera) with xiCamTool
             (menu of the (i) toolbar button). -->
        <applyXiCameraFile name="camera-settings.xicamera"/>
        <!-- Parameters set afterwards override the file: exposure 1 ms -->
        <setCameraParam name="XI_PRM_EXPOSURE" value="1000"/>
    </cameraTask>
</tasks>
</RecordingSetup>
