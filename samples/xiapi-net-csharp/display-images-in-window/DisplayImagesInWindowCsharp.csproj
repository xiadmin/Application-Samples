<Project Sdk="Microsoft.NET.Sdk">

  <!-- dependencies/Directory.Packages.props is imported automatically through
       DirectoryPackagesPropsPath in the repository-root Directory.Build.props. -->

  <PropertyGroup>
    <!-- Exe rather than WinExe keeps a console for stderr messages, such as a
         missing camera, next to the preview window. -->
    <OutputType>Exe</OutputType>
    <!-- Target latest LTS .NET; update when a new LTS ships. Windows Forms
         needs the -windows target. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>display-images-in-window-csharp</AssemblyName>
    <RootNamespace>Ximea.Samples</RootNamespace>
    <!-- Force x64 — xiApi.NETX64.dll is 64-bit only. -->
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <XimeaSpPath Condition="'$(XimeaSpPath)' == ''">$(XIMEA_SP_PATH)</XimeaSpPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="xiApi.NETX64">
      <HintPath>$(XimeaSpPath)\API\xiAPI.NET.NET.7.0\xiApi.NETX64.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="CheckXimeaSpPath" BeforeTargets="Build">
    <Error Condition="'$(XimeaSpPath)' == ''"
           Text="XIMEA SDK path is not set. Run the XIMEA installer (which sets XIMEA_SP_PATH) or pass -p:XimeaSpPath=&lt;path&gt; to dotnet build." />
  </Target>

</Project>
