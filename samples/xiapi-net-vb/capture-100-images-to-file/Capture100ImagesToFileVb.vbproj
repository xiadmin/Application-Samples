<Project Sdk="Microsoft.NET.Sdk">

  <!-- dependencies/Directory.Packages.props is imported automatically through
       DirectoryPackagesPropsPath in the repository-root Directory.Build.props. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Target latest LTS .NET; update when a new LTS ships. The WPF imaging
         classes (JpegBitmapEncoder) need the -windows target. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- The VB counterpart of the strict C# settings: no late binding or
         implicit narrowing conversions, and every variable is declared. -->
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <AssemblyName>capture-100-images-to-file-vb</AssemblyName>
    <RootNamespace>Ximea.Samples</RootNamespace>
    <!-- Force x64 — xiApi.NETX64.dll is 64-bit only. -->
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <XimeaSpPath Condition="'$(XimeaSpPath)' == ''">$(XIMEA_SP_PATH)</XimeaSpPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="xiApi.NETX64">
      <HintPath>$(XimeaSpPath)\API\xiAPI.NET.NET.7.0\xiApi.NETX64.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="CheckXimeaSpPath" BeforeTargets="Build">
    <Error Condition="'$(XimeaSpPath)' == ''"
           Text="XIMEA SDK path is not set. Run the XIMEA installer (which sets XIMEA_SP_PATH) or pass -p:XimeaSpPath=&lt;path&gt; to dotnet build." />
  </Target>

</Project>
